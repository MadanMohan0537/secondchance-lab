{
  "name": "secondchance-lab",
  "version": "0.1.0",
  "description": "Chaos testing for ambiguous transaction outcomes",
  "type": "module",
  "bin": { "secondchance": "dist/cli.js" },
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/cli.ts",
    "demo": "node --import tsx src/cli.ts demo",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "check": "tsc -p tsconfig.json --noEmit && npm test"
  },
  "engines": { "node": ">=20" },
  "keywords": ["chaos-testing", "reliability", "idempotency", "payments", "ci"],
  "license": "Apache-2.0",
  "dependencies": { "yaml": "^2.8.1" },
  "devDependencies": { "@types/node": "^24.7.2", "tsx": "^4.20.6", "typescript": "^5.9.3" }
}
